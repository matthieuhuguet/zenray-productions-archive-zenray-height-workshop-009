def L_eq(ctx, radii=(1.0, 2.0, 4.0, 8.0)):
    """11 October 2026 : measured frequency equaliser fitted on the current result at full resolution (FitEqualizer)."""
    import FitEqualizer as FE
    w, _ = FE.fit(ctx["r"], ctx["c"], ctx["v"], radii)
    return {"type": "eq", "radii": list(radii), "weights": [round(x, 5) for x in w], "note": "frequency equaliser, least squares at full resolution"}
