    "M04_MaskClassesStatistical": ("Black and white mask classes reproduced by thresholded noise with measured coverage", fixed([L_joint, lambda c: [L_noise_mask(c, "bright", "M04")], lambda c: [L_noise_mask(c, "dark", "M04")], lambda c: [L_noise_mask(c, "lines", "M04")]])),
