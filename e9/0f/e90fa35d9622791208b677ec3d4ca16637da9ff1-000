# 11 October 2026 : can a measured unsharp mask (c + k * (c - blur(c, s))) explain the full resolution residual?
# k is fitted by least squares for each radius; scores at full resolution. FR : test d'un masque de netteté mesuré.
import os
import sys
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import numpy as np
from RefLib import load_gray
import Fit as F


def pc(a, b):
    a = a - a.mean(); b = b - b.mean()
    return float((a * b).sum() / np.sqrt((a * a).sum() * (b * b).sum()))


if __name__ == "__main__":
    r = load_gray(sys.argv[1]); c = load_gray(sys.argv[2])
    print("start", round(pc(c, r), 4))
    best = None
    for s in (0.5, 0.75, 1.0, 1.5, 2.0, 3.0):
        hp = c - F.blur(c, s)
        res = r - c
        k = float((hp * res).sum() / (hp * hp).sum())
        out = c + k * hp
        p = pc(out, r)
        print(f"radius {s}: k {k:.3f} -> {p:.4f}")
        if best is None or p > best[0]:
            best = (p, s, k)
    # two radii combined (least squares on both high passes)
    H = np.stack([(c - F.blur(c, 0.75)).ravel(), (c - F.blur(c, 2.0)).ravel()], 1)
    w, *_ = np.linalg.lstsq(H, (r - c).ravel(), rcond=None)
    print("two radii 0.75 + 2.0:", np.round(w, 3), round(pc(c + (H @ w).reshape(c.shape), r), 4))
